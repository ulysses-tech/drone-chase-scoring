// Firestore 보안 규칙 예시 — Firebase 콘솔 → Firestore Database → 규칙(Rules) 탭에 붙여넣기
// 대회 기간에만 읽기/쓰기를 허용하고, 저장되는 데이터 형식을 검사합니다.
// 날짜는 대회 일정에 맞게 고치세요.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /orbital_scores_2026/{docId} {
      allow read: if request.time < timestamp.date(2026, 12, 31);
      allow create, update: if request.time < timestamp.date(2026, 12, 31)
        && request.resource.data.bib is string
        && request.resource.data.name is string
        && request.resource.data.obstacles is list
        && request.resource.data.landingScore is number
        && request.resource.data.lapTime is number;
      allow delete: if request.time < timestamp.date(2026, 12, 31);
    }
  }
}
